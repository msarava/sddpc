{
  "extends": "../tsconfig.json",

  "compilerOptions": {
    "composite": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "incremental": true
  },
  "include": ["src"]
}
