# Build stage
FROM node:22-alpine as build

WORKDIR /app

# Install pnpm with corepack
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy application code
COPY . .

# Build the application
RUN pnpm run build

# Production stage
FROM node:22-alpine as production

# Create non-root user first - using Alpine's adduser
RUN addgroup -S -g 1001 nodejs && \
    adduser -S -u 1001 -G nodejs nestjs

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Copy only necessary production files and set ownership in one layer
COPY --from=build --chown=nestjs:nodejs /app/dist ./dist
COPY --from=build --chown=nestjs:nodejs /app/package.json ./
COPY --from=build --chown=nestjs:nodejs /app/pnpm-lock.yaml ./

# Set NODE_ENV and install production dependencies
ENV NODE_ENV=production
RUN pnpm install --prod --frozen-lockfile && \
    pnpm store prune

# Switch to non-root user
USER nestjs

# Clean up
RUN rm -rf ~/.npm ~/.pnpm-store

# Start application
CMD ["node", "dist/main"]
